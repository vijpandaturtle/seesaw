ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
LANGSMITH_API_KEY=

# Optional. Neuronpedia read endpoints need no key.
NEURONPEDIA_API_KEY=
# Set to 1 to let Lens generate attribution graphs on Neuronpedia (circuit_tracing).
# Generated graphs and their prompts are public on neuronpedia.org.
SEESAW_NEURONPEDIA_PUBLISH=

# Which interp library Lens runs: seesaw (default; TransformerLens text models)
# or lever (vision-language models: LLaVA, Qwen-VL, CLIP; needs the [lever] extra).
SEESAW_INTERP_BACKEND=
# Where relative image paths in a research plan resolve (lever backend). Default: working directory.
SEESAW_IMAGE_DIR=

# Hugging Face token: needed for the gated models (google/gemma-2-2b, the default, and Llama).
# Qwen2.5 models are open.
HF_TOKEN=
